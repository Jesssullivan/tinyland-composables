"""
BUILD.bazel for @tummycrypt/tinyland-composables.

Dual-mode build: works with both pnpm (standalone) and Bazel (CI/production).
  Standalone: pnpm build && pnpm test
  Bazel:      CI (.github/workflows/ci.yml) builds //:pkg and //:test.
              It does not run `bazel test`.
              A local `bazel test //...` is local, non-qualifying.
  Consumers:  bazel_dep(name = "tummycrypt_tinyland_composables", version = "1.0.0")
              from xoxd-ai/bazel-registry; the package is not published to npm.

The sources are .ts and .svelte.ts modules only (no .svelte components), so
TypeScript 7.0.2 compiles them directly: foo.svelte.ts emits foo.svelte.js with
the runes left in place for the consumer's Svelte compiler, plus foo.svelte.d.ts.
This replaces svelte-package, whose svelte2tsx emitDts does not run on
TypeScript 7 (RU13). The rune globals come from the svelte types (tsconfig
"types": ["svelte"]).
"""

load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@tummycrypt_tinyland_composables_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_composables_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm link - makes node_modules available for this package
# =============================================================================

npm_link_all_packages(name = "node_modules")

# =============================================================================
# TypeScript compilation (TypeScript 7.0.2, native)
# =============================================================================

ts_project(
    name = "tinyland_composables",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [":node_modules/svelte"],
    visibility = ["//visibility:public"],
)

# Plain output files only. svelte is a peer dependency: the consumer links its
# own copy, so the package must not carry this repo's npm store links.
# DefaultInfo holds the .js files; the declarations (.d.ts, .d.ts.map) are in
# the ts_project "types" output group, so both are listed.
filegroup(
    name = "dist",
    srcs = [":tinyland_composables"],
)

filegroup(
    name = "dist_types",
    srcs = [":tinyland_composables"],
    output_group = "types",
)

# =============================================================================
# npm package target
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        ":dist",
        ":dist_types",
    ],
    package = "@tummycrypt/tinyland-composables",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    data = [
        ":node_modules",
        "package.json",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck-only target (no emit)
# =============================================================================

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [":node_modules/svelte"],
    visibility = ["//visibility:public"],
)

# Typecheck of the tests together with src (no emit). Tests run in Node with
# happy-dom globals, so they see both the DOM and @types/node declarations.
ts_config(
    name = "tsconfig_test",
    src = "tsconfig.test.json",
    deps = ["tsconfig.json"],
)

ts_project(
    name = "typecheck_tests",
    srcs = glob(["src/**/*.ts", "tests/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig_test",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":node_modules/@types/node",
        ":node_modules/happy-dom",
        ":node_modules/svelte",
        ":node_modules/vitest",
    ],
)

# =============================================================================
# Exported files for downstream consumers
# =============================================================================

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
